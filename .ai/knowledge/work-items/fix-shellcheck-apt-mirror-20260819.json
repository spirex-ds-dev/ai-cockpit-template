  "designDecisions": [
    {
      "decision": "Use the runner-provided ShellCheck instead of installing it through apt.",
      "reason": "Hosted evidence shows the job repeatedly timed out at azure.archive.ubuntu.com before ShellCheck started, while the pinned runner image provides ShellCheck.",
      "status": "verified"
    },
    {
      "decision": "Pin the ShellCheck lane to Ubuntu 24.04.",
      "reason": "The tool availability assumption is kept stable at the workflow boundary instead of depending on a moving ubuntu-latest image.",
      "status": "verified"
    },
    {
      "decision": "Do not distribute template repository reference-impact records to adopters.",
      "reason": "Those records bind to template-local target paths; copying them into an adopter makes the adopter's full-repository reference-impact check fail when the target workflow is absent.",
      "status": "verified"
    },
    {
      "decision": "Treat an empty tracked git diff as a valid isolated-shard input.",
      "reason": "Hosted verification uses a clean committed snapshot; piping an empty diff to git apply returns 128 even though there are no changes to apply.",
      "status": "verified"
    }
  ],
