  "designDecisions": [
    {
      "decision": "Serialize only shared Git worktree metadata, not pytest execution.",
      "reason": "The five shard runners must remain parallel while Git common-directory mutations are protected from collisions.",
      "status": "verified"
    },
    {
      "decision": "Use a unique run directory for every Make invocation.",
      "reason": "An interrupted or retried parent process must not collide with stale generated workspace paths.",
      "status": "verified"
    },
    {
      "decision": "Keep installed adopter PROJECT_TEST execution outside this pytest-specific helper.",
      "reason": "The installed template surface is stack-neutral; automatically claiming pytest orchestration for adopters would overstate inherited capability.",
      "status": "verified"
    }
  ],
